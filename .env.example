# ---------------------------------------------------------------------------
# Raabta Live — environment. Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# AssemblyAI — Realtime Speech-to-Text (the Path-2 core). https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=

# --- LLM brain (set ONE) ---------------------------------------------------
# OpenAI (or any OpenAI-compatible endpoint) is the default.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Optional: Google Gemini via its OpenAI-compatible endpoint.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- TTS voice (set ONE) ---------------------------------------------------
# ElevenLabs is the default (great multilingual voices).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5
# Cartesia is the lowest-latency option (~260ms first audio).
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# --- Server ----------------------------------------------------------------
PORT=8790
# Opening line the DEMO agent speaks (real tenants set their own per agent).
AGENT_GREETING=Thanks for calling Raabta. How can I help you today?

# --- Platform (multi-tenant SaaS) -----------------------------------------
# Directory holding the SQLite database. Mount a persistent disk here in prod.
DATA_DIR=./data
# Max simultaneous live calls per tenant (abuse cap on public embed keys).
MAX_CONCURRENT_CALLS_PER_TENANT=5
# Hard cap on a single voice session's wall-clock in ms (bounds provider spend).
SESSION_MAX_MS=600000
# Salt for privacy-preserving client-IP hashing — set a random value in prod.
IP_HASH_SALT=
